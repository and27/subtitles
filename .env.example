# OpenAI (LLM hints)
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional override for base URL (for proxies or compatible APIs)
OPENAI_BASE_URL=https://api.openai.com/v1

# STT (cloud)
STT_PROVIDER=local
STT_CLOUD_API_KEY=
STT_CLOUD_MODEL=whisper-1
STT_CLOUD_BASE_URL=https://api.openai.com/v1

# Latency target (ms)
LATENCY_TARGET_MS=1200
