# OpenAI (LLM hints)
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional override for base URL (for proxies or compatible APIs)
OPENAI_BASE_URL=https://api.openai.com/v1

# STT (cloud)
STT_PROVIDER=local
STT_CLOUD_API_KEY=
STT_CLOUD_MODEL=whisper-1
STT_CLOUD_BASE_URL=https://api.openai.com/v1

# Latency target (ms)
LATENCY_TARGET_MS=1200

# Overlay nudge hotkeys (optional)
OVERLAY_NUDGE_STEP=0.05
OVERLAY_NUDGE_UP=CommandOrControl+Alt+Up
OVERLAY_NUDGE_DOWN=CommandOrControl+Alt+Down

# Overlay page hotkeys (optional)
OVERLAY_PAGE_PREV=CommandOrControl+Alt+Left
OVERLAY_PAGE_NEXT=CommandOrControl+Alt+Right

# Overlay max lines hotkeys (optional)
OVERLAY_MAX_LINES_STEP=1
OVERLAY_MAX_LINES_UP=CommandOrControl+Alt+F9
OVERLAY_MAX_LINES_DOWN=CommandOrControl+Alt+F10

# Overlay font size hotkeys (optional)
OVERLAY_FONT_STEP=1
OVERLAY_FONT_UP=CommandOrControl+Alt+F11
OVERLAY_FONT_DOWN=CommandOrControl+Alt+F12

# Overlay opacity hotkeys (optional)
OVERLAY_OPACITY_STEP=0.05
OVERLAY_OPACITY_UP=CommandOrControl+Alt+F8
OVERLAY_OPACITY_DOWN=CommandOrControl+Alt+F7
